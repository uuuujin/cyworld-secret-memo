rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() <= 100
        && (!('hompyTitle' in data) || (data.hompyTitle is string && data.hompyTitle.size() <= 100))
        && (!('statusMessage' in data) || (data.statusMessage is string && data.statusMessage.size() <= 150))
        && (!('todayMood' in data) || (data.todayMood is string && data.todayMood.size() <= 30))
        && (!('bgmTitle' in data) || (data.bgmTitle is string && data.bgmTitle.size() <= 80))
        && (!('todayCount' in data) || data.todayCount is number)
        && (!('totalCount' in data) || data.totalCount is number)
        && (!('passcode' in data) || (data.passcode is string && data.passcode.size() <= 10))
        && (!('isLockEnabled' in data) || data.isLockEnabled is bool);
    }

    function isValidMemo(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 150
        && data.content is string && data.content.size() <= 10000
        && data.folder is string && data.folder.size() <= 30
        && (!('mood' in data) || (data.mood is string && data.mood.size() <= 30))
        && (!('weather' in data) || (data.weather is string && data.weather.size() <= 20))
        && (!('isSecret' in data) || data.isSecret is bool)
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('bgPattern' in data) || (data.bgPattern is string && data.bgPattern.size() <= 30))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
    }

    function isValidQuickNote(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.content is string && data.content.size() <= 300
        && (!('mood' in data) || (data.mood is string && data.mood.size() <= 30));
    }

    // User profile matching - strictly owner only
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // No public user directory listing

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == userId
        && isValidUser(incoming());

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == existing().userId
        && isValidUser(incoming());

      allow delete: if isOwner(userId);

      // Memos subcollection
      match /memos/{memoId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(memoId)
          && incoming().userId == userId
          && incoming().id == memoId
          && isValidMemo(incoming());

        allow update: if isOwner(userId)
          && isValidId(memoId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id
          && isValidMemo(incoming());

        allow delete: if isOwner(userId);
      }

      // Quick notes subcollection
      match /quickNotes/{noteId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(noteId)
          && incoming().userId == userId
          && incoming().id == noteId
          && isValidQuickNote(incoming());

        allow update: if isOwner(userId)
          && isValidId(noteId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id
          && isValidQuickNote(incoming());

        allow delete: if isOwner(userId);
      }
    }
  }
}
